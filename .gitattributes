# Normalize line endings so the repository stays consistent across Windows,
# Linux and macOS checkouts. Without this, files authored on Windows land in the
# history with CRLF and show up as whole-file diffs for anyone on another
# platform.
#
# "text=auto" stores every file git detects as text with LF in the repository
# and converts to the platform's native ending on checkout.
* text=auto

# Files whose endings matter to a tool, regardless of host platform.
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile text eol=lf

# Windows-only scripts must keep CRLF or cmd.exe mis-parses them.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Visual Studio solution files are a Windows format.
*.sln   text eol=crlf

# Binary formats: never convert, never diff as text.
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.dll   binary
*.exe   binary
