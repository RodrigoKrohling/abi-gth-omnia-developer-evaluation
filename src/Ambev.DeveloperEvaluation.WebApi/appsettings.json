{
  "ConnectionStrings": {
    // PostgreSQL, matching the credentials declared for the
    // "ambev.developerevaluation.database" service in docker-compose.yml.
    //
    // Host is "localhost" here because this file serves a local `dotnet run`
    // against the container's published port. When the API itself runs inside
    // compose, docker-compose.yml overrides this value through the
    // ConnectionStrings__DefaultConnection environment variable so that Host
    // becomes the database service name on the compose network.
    "DefaultConnection": "Host=localhost;Port=5432;Database=developer_evaluation;Username=developer;Password=ev@luAt10n"
  },
  "Jwt": {
    "SecretKey": "YourSuperSecretKeyForJwtTokenGenerationThatShouldBeAtLeast32BytesLong"
  },

  // Append-only audit trail of published domain events.
  //
  // Disabled by default so the API runs against PostgreSQL alone. Set Enabled to
  // true when the compose stack is up; docker-compose.yml turns it on through
  // Mongo__Enabled for the containerised run. When it is off, or when MongoDB is
  // unreachable, events are still written to the application log and the business
  // operation is unaffected.
  "Mongo": {
    "Enabled": false,
    "ConnectionString": "mongodb://developer:ev%40luAt10n@localhost:27017/?authSource=admin",
    "Database": "developer_evaluation",
    "EventsCollection": "sale_events"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
